{
  "opencollection": "1.0.0",
  "info": {
    "name": "Signadot Cluster Sandboxes API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "Sandboxes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List sandboxes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/orgs/:orgName/sandboxes",
            "params": [
              {
                "name": "orgName",
                "value": "",
                "type": "path",
                "description": "Signadot Org Name"
              }
            ]
          },
          "docs": "List all sandboxes under the specified Signadot org."
        },
        {
          "info": {
            "name": "Get a sandbox",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/orgs/:orgName/sandboxes/:sandboxName",
            "params": [
              {
                "name": "orgName",
                "value": "",
                "type": "path",
                "description": "Signadot Org Name"
              },
              {
                "name": "sandboxName",
                "value": "",
                "type": "path",
                "description": "Sandbox Name"
              }
            ]
          },
          "docs": "Fetch the details about a given sandbox."
        },
        {
          "info": {
            "name": "Create or update a sandbox",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/orgs/:orgName/sandboxes/:sandboxName",
            "params": [
              {
                "name": "orgName",
                "value": "",
                "type": "path",
                "description": "Signadot Org Name"
              },
              {
                "name": "sandboxName",
                "value": "",
                "type": "path",
                "description": "Sandbox Name"
              }
            ]
          },
          "docs": "Creates or updates a sandbox with the provided parameters."
        },
        {
          "info": {
            "name": "Delete a sandbox",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/orgs/:orgName/sandboxes/:sandboxName",
            "params": [
              {
                "name": "orgName",
                "value": "",
                "type": "path",
                "description": "Signadot Org Name"
              },
              {
                "name": "sandboxName",
                "value": "",
                "type": "path",
                "description": "Sandbox Name"
              },
              {
                "name": "force",
                "value": "",
                "type": "query",
                "description": "force"
              }
            ]
          },
          "docs": "Delete a given sandbox."
        }
      ]
    }
  ],
  "bundled": true
}